# Copy to .env for local work; set these as Railway variables in production.

DEBUG=0
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-50
ALLOWED_HOSTS=your-app.up.railway.app
DATA_DIR=/data
TIME_ZONE=UTC

# RAILWAY_PUBLIC_DOMAIN is injected by Railway and is trusted automatically,
# so CSRF_TRUSTED_ORIGINS is only needed for a custom domain.
# CSRF_TRUSTED_ORIGINS=https://library.example.com

# Off-box backups. {path} is replaced with each artefact; run without a shell.
# BACKUP_UPLOAD_CMD=rclone copy {path} r2:library-backups/
